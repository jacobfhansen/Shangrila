; Engine configuration file.
; Shangrila - Godot recreation of a 1997 Macintosh Pascal adventure game.

config_version=5

[application]

config/name="Shangrila"
config/description="Recreation of the unfinished 1997 Macintosh game Shangrila"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=480
window/size/window_width_override=1280
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

common/drop_mouse_on_gui_input_disabled=true
timers/tooltip_delay_sec=0.35

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/integer_division=0
